{
  "name": "graz",
  "description": "React hooks for Cosmos",
  "version": "0.4.0-alpha.2",
  "author": "Nur Fikri <kikiding.space@gmail.com>",
  "repository": "https://github.com/graz-sh/graz.git",
  "homepage": "https://github.com/graz-sh/graz",
  "bugs": "https://github.com/graz-sh/graz/issues",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "module": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./chains": {
      "types": "./chains/index.ts",
      "module": "./chains/index.mjs",
      "default": "./chains/index.js"
    }
  },
  "files": [
    "chains/*.stub",
    "dist/*",
    "types/*",
    "env.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist/*",
    "cli": "node dist/cli.js",
    "dev": "tsup --watch",
    "lint": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:cli": "vitest run src/__tests__/cli.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=17",
    "@cosmjs/amino": ">=0.32.4",
    "@cosmjs/cosmwasm-stargate": ">=0.32.4",
    "@cosmjs/proto-signing": ">=0.32.4",
    "@cosmjs/stargate": ">=0.32.4",
    "@cosmjs/encoding": ">=0.32.4"
  },
  "dependencies": {
    "@initia/initia-registry-types": "0.0.20",
    "@keplr-wallet/types": "0.12.156",
    "@cosmsnap/snapper": "0.2.7",
    "@dao-dao/cosmiframe": "1.0.0",
    "@keplr-wallet/cosmos": "0.12.156",
    "@vectis/extension-client": "^0.7.2",
    "@walletconnect/sign-client": "2.20.2",
    "@walletconnect/types": "2.20.2",
    "@walletconnect/utils": "2.20.2",
    "@walletconnect/modal": "2.7.0",
    "cosmos-directory-client": "0.0.6",
    "long": "4",
    "p-map": "^4.0.0",
    "zustand": "5.0.4"
  },
  "devDependencies": {
    "@getpara/graz-connector": "2.0.0-alpha.51",
    "@getpara/web-sdk": "2.0.0-alpha.51",
    "@types/node": "^18.17.15",
    "@types/react": "^18.2.21",
    "@vitest/ui": "^1.0.0",
    "arg": "^5.0.2",
    "jsdom": "^23.0.0",
    "react": "^18.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "graz",
    "keplr-wallet",
    "keplr",
    "react-cosmos-hooks",
    "graz-sh",
    "use-keplr"
  ],
  "license": "MIT"
}
