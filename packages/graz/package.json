{
  "name": "graz",
  "description": "React hooks for Cosmos",
  "version": "0.6.0",
  "author": "Nur Fikri <kikiding.space@gmail.com>",
  "repository": "https://github.com/graz-sh/graz.git",
  "homepage": "https://github.com/graz-sh/graz",
  "bugs": "https://github.com/graz-sh/graz/issues",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "module": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./chains": {
      "types": "./chains/index.ts",
      "module": "./chains/index.mjs",
      "default": "./chains/index.js"
    }
  },
  "files": [
    "chains/*.stub",
    "dist/*",
    "types/*",
    "env.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist/*",
    "cli": "node dist/cli.js",
    "dev": "tsup --watch",
    "lint": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:cli": "vitest run src/__tests__/cli.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@cosmjs/amino": ">=0.32.4",
    "@cosmjs/cosmwasm-stargate": ">=0.32.4",
    "@cosmjs/encoding": ">=0.32.4",
    "@cosmjs/proto-signing": ">=0.32.4",
    "@cosmjs/stargate": ">=0.32.4",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "@getpara/graz-integration": {
      "optional": true
    }
  },
  "dependencies": {
    "@cosmsnap/snapper": "0.2.7",
    "@dao-dao/cosmiframe": "1.0.0",
    "@keplr-wallet/types": "0.13.39",
    "@vectis/extension-client": "0.7.2",
    "@walletconnect/modal": "2.7.0",
    "@walletconnect/sign-client": "2.23.9",
    "@walletconnect/types": "2.23.9",
    "@walletconnect/utils": "2.23.9",
    "cosmos-directory-client": "0.0.6",
    "long": "5.3.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@cosmjs/amino": "0.39.0",
    "@cosmjs/cosmwasm-stargate": "0.38.1",
    "@cosmjs/encoding": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@getpara/web-sdk": "3.3.0",
    "@metamask/providers": "16.1.0",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@vitest/ui": "4.1.9",
    "arg": "5.0.2",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "typescript": "6.0.3",
    "vite": "7.3.5",
    "vitest": "4.1.9"
  },
  "keywords": [
    "graz",
    "keplr-wallet",
    "keplr",
    "react-cosmos-hooks",
    "graz-sh",
    "use-keplr"
  ],
  "license": "MIT"
}
