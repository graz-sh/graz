{
  "name": "@project/graz-playwright-integration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:deps": "pnpm --filter graz build",
    "dev": "vite --host 127.0.0.1 --port 4177 --strictPort",
    "lint": "eslint --fix \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4177 --strictPort",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@cosmjs/amino": "0.39.0",
    "@cosmjs/encoding": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@tanstack/react-query": "5.101.0",
    "graz": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.5",
    "vite-plugin-node-stdlib-browser": "0.2.1"
  }
}
