{
  "name": "graz-sh",
  "version": "0.0.0",
  "workspaces": [
    "docs",
    "example/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=!@project/example-next --filter=!@project/starter --filter=!@project/example-vite",
    "build-all": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --filter=!@project/docs",
    "project:docs": "pnpm --dir docs",
    "example:next": "pnpm --dir example/next",
    "example:vite": "pnpm --dir example/vite",
    "example:starter": "pnpm --dir example/starter",
    "graz": "pnpm --dir packages/graz",
    "lint": "turbo run lint",
    "release": "pnpm graz build && changeset publish",
    "test": "turbo run test",
    "postinstall": "npx setup-para"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@graz-sh/style-guide": "^4.0.1",
    "eslint": "^8.49.0",
    "p-map": "^4.0.0",
    "prettier": "^3.0.3",
    "tsup": "^7.2.0",
    "turbo": "^1.10.13",
    "typescript": "^5.4.0"
  },
  "prettier": "@graz-sh/style-guide/prettier",
  "private": true,
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "ses": ">=0.18.7",
      "trim": ">=0.0.3",
      "axios": ">=0.30.2",
      "next": ">=14.2.15",
      "got": ">=11.8.5",
      "esbuild": ">=0.25.0",
      "webpack-dev-server": ">=5.2.1",
      "vite": ">=5.4.20",
      "wait-on": ">=7.0.0"
    }
  }
}
