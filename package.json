{
  "name": "graz-sh",
  "version": "0.0.0",
  "workspaces": [
    "docs",
    "example/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=!@project/example-vite --filter=!@project/example-playground",
    "build-all": "turbo run build",
    "clean": "turbo run clean",
    "dev": "pnpm graz build && turbo run dev --filter=!@project/docs",
    "project:docs": "pnpm --dir docs",
    "example:vite": "pnpm --dir example/vite",
    "example:playground": "pnpm --dir example/playground",
    "graz": "pnpm --dir packages/graz",
    "lint": "turbo run lint",
    "release": "pnpm graz build && changeset publish",
    "test": "turbo run test",
    "postinstall": "npx setup-para"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.3",
    "tsup": "^8.3.5",
    "turbo": "^2.9.14",
    "typescript": "^5.4.0"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "ses": ">=0.18.7",
      "axios": ">=0.30.2",
      "next": ">=14.2.15",
      "got": ">=11.8.5",
      "esbuild": ">=0.25.0",
      "webpack-dev-server": ">=5.2.1",
      "vite": ">=5.4.20",
      "graz>vite": "5.4.11",
      "wait-on": ">=7.0.0",
      "glob": ">=10.0.0",
      "rimraf": ">=5.0.0",
      "@cosmjs/crypto": ">=0.32.4",
      "@getpara/graz-connector": "2.0.0-alpha.51"
    }
  }
}
