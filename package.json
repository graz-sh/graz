{
  "name": "graz-sh",
  "version": "0.0.0",
  "workspaces": [
    "docs",
    "example/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=!@project/example-vite --filter=!@project/example-playground",
    "build-all": "turbo run build",
    "clean": "turbo run clean",
    "dev": "pnpm graz build && turbo run dev --filter=!@project/docs",
    "project:docs": "pnpm --dir docs",
    "example:vite": "pnpm --dir example/vite",
    "example:playground": "pnpm --dir example/playground",
    "graz": "pnpm --dir packages/graz",
    "integration:test": "pnpm --dir integration/playwright test:e2e",
    "integration:test:ui": "pnpm --dir integration/playwright test:e2e:ui",
    "lint": "turbo run lint",
    "release": "pnpm graz build && changeset publish",
    "test": "turbo run test",
    "postinstall": "pnpm exec setup-para"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.4",
    "@playwright/test": "1.61.0",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitest/coverage-v8": "4.1.11",
    "cosmjs-types": "0.11.0",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.8.4",
    "tsup": "8.5.1",
    "turbo": "2.9.18",
    "typescript": "6.0.3"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "24.17.0",
    "pnpm": "11.8.0"
  }
}
