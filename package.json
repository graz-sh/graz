{
  "name": "graz-sh",
  "version": "0.0.0",
  "workspaces": [
    "docs",
    "example/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=!@project/example-vite --filter=!@project/example-playground",
    "build-all": "turbo run build",
    "clean": "turbo run clean",
    "dev": "pnpm graz build && turbo run dev --filter=!@project/docs",
    "project:docs": "pnpm --dir docs",
    "example:vite": "pnpm --dir example/vite",
    "example:playground": "pnpm --dir example/playground",
    "graz": "pnpm --dir packages/graz",
    "lint": "turbo run lint",
    "release": "pnpm graz build && changeset publish",
    "test": "turbo run test",
    "postinstall": "npx setup-para"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.3",
    "tsup": "^8.3.5",
    "turbo": "^1.10.13",
    "typescript": "^5.4.0"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "ses": ">=0.18.7",
      "axios": ">=1.13.5",
      "next": ">=15.5.10",
      "got": ">=11.8.5",
      "esbuild": ">=0.25.0",
      "webpack-dev-server": ">=5.2.1",
      "webpack": ">=5.104.1",
      "vite": ">=5.4.21",
      "graz>vite": "5.4.21",
      "wait-on": ">=7.0.0",
      "glob": ">=10.5.0",
      "rimraf": ">=5.0.0",
      "@cosmjs/crypto": ">=0.32.4",
      "@getpara/graz-connector": "2.0.0-alpha.51",
      "h3": ">=1.15.5",
      "node-forge": ">=1.3.2",
      "qs": ">=6.14.2",
      "lodash": ">=4.17.23",
      "mdast-util-to-hast": ">=13.2.1",
      "prismjs": ">=1.30.0",
      "eslint>ajv": "^6.14.0",
      "@eslint/eslintrc>ajv": "^6.14.0",
      "js-yaml": "^4.1.1",
      "gray-matter>js-yaml": "^3.14.2",
      "read-yaml-file>js-yaml": "^3.14.2",
      "ua-parser-js>undici": ">=7.18.2"
    }
  }
}
